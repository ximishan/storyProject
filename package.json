{
  "name": "storybound-rebuild",
  "version": "0.6.0",
  "private": true,
  "description": "A maintainable Storybound-compatible AI video creation desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "test:workflow": "node scripts/workflow-smoke-test.cjs",
    "test:advanced": "node scripts/advanced-workflow-test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.27.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.storybound.rebuild",
    "productName": "Storybound",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/draft-generator.exe",
        "to": "draft-generator.exe"
      },
      {
        "from": "resources/default-bgm.mp3",
        "to": "default-bgm.mp3"
      },
      {
        "from": "resources/bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "electron/sapi.ps1",
        "to": "sapi.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  }
}
