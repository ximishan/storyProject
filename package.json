{
  "name": "storybound-rebuild",
  "version": "0.9.4",
  "private": true,
  "description": "A maintainable Storybound-compatible AI video creation desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "test:workflow": "node scripts/workflow-smoke-test.cjs",
    "test:advanced": "node scripts/advanced-workflow-test.cjs",
    "test:dynamic": "node scripts/dynamic-scene-test.cjs",
    "test:script-modes": "node scripts/script-mode-test.cjs",
    "test:openai-image": "node scripts/openai-image-api-test.cjs",
    "test:llm-planner": "node scripts/llm-planner-test.cjs",
    "test:reference-routing": "node scripts/reference-routing-test.cjs",
    "test:checkpoint": "node scripts/checkpoint-recovery-test.cjs",
    "test:voice-previews": "node scripts/official-voice-preview-test.cjs",
    "test:llm-protocol": "node scripts/llm-protocol-test.cjs",
    "test:llm-json-repair": "node scripts/llm-json-repair-test.cjs",
    "test:image-prompt-safety": "node scripts/image-prompt-safety-test.cjs",
    "test:image-response": "node scripts/image-response-format-test.cjs",
    "test:image-poll-url": "node scripts/image-poll-url-test.cjs",
    "test:motion": "node scripts/motion-render-test.cjs",
    "test:caption": "node scripts/caption-punctuation-test.cjs && node scripts/subtitle-single-line-test.cjs",
    "test:character-db": "electron scripts/character-consistency-db-test.cjs",
    "test:prompts": "node scripts/prompt-template-integration-test.cjs",
    "test:references": "node scripts/reference-routing-parity-test.cjs",
    "test:style-previews": "node scripts/style-preview-assets-test.cjs",
    "test:parity": "node scripts/parity-audit-test.cjs",
    "test:voice-preview-parity": "node scripts/voice-preview-parity-test.cjs",
    "test:style-integrity": "node scripts/style-integrity-regression-test.cjs",
    "test:style-request-routing": "node scripts/style-request-routing-test.cjs",
    "test:cancellation": "node scripts/cancellation-flow-test.cjs",
    "test:apimart": "node scripts/apimart-image-test.cjs",
    "test:image-soft-cancel": "node scripts/image-soft-cancel-test.cjs",
    "test:apimart-proxy": "node scripts/apimart-proxy-routing-test.cjs",
    "test:voice-memory": "node scripts/voice-memory-test.cjs && node scripts/voice-selection-regression-test.cjs",
    "test:image-partial-recovery": "node scripts/image-partial-recovery-test.cjs",
    "test:scenes-batch": "node scripts/scenes-batch-generation-test.cjs && node scripts/scenes-batch-retry-test.cjs",
    "test:scene-density": "node scripts/scene-density-test.cjs",
    "test:claude-storyboard": "node scripts/claude-storyboard-validation-test.cjs",
    "test:claude-boundary-recovery": "node scripts/claude-boundary-recovery-test.cjs",
    "test:semiauto-locked-text": "node scripts/semiauto-locked-text-test.cjs",
    "test:single-dad": "node scripts/single-dad-reference-routing-test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.27.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.storybound.rebuild",
    "productName": "Storybound",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/sapi.ps1",
        "to": "sapi.ps1"
      },
      {
        "from": "electron/sapi-voices.ps1",
        "to": "sapi-voices.ps1"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
